# ─── MJ Data Cluster · variables d'environnement ───
# Copier ce fichier en `.env` et remplir. Ne JAMAIS committer `.env`.

# Ports
WEB_PORT=3000
WS_DATA_PORT=3001

# ─── GPS USB (u-blox NMEA) ───
# Mettre GPS_ENABLED=0 pour forcer la position simulée (dev PC sans GPS)
GPS_ENABLED=1
GPS_DEVICE=/dev/ttyACM0
# Marge de sécurité sur la vitesse affichée (km/h) — négatif = on retire
GPS_SPEED_OFFSET=-5
# port HTTPS dédié au callback OAuth Spotify (Spotify exige https)
HTTPS_PORT=3443
# où renvoyer le navigateur après connexion
APP_URL=http://127.0.0.1:3000

# ─── Spotify (à remplir au setup — voir docs/SPOTIFY.md) ───
# App créée sur https://developer.spotify.com/dashboard (flow PKCE, pas de client secret)
SPOTIFY_CLIENT_ID=votre_client_id_spotify
# redirect_uri déclaré dans l'app Spotify (doit correspondre EXACTEMENT)
SPOTIFY_REDIRECT_URI=https://127.0.0.1:3443/spotify/callback
# Nom du device librespot (Spotify Connect) vers lequel basculer la lecture
SPOTIFY_DEVICE_NAME=MJ Data SJ413
# Premium requis pour la lecture via librespot

# ─── Géocodage / Routing (en ligne au début) ───
NOMINATIM_URL=https://nominatim.openstreetmap.org
OSRM_URL=https://router.project-osrm.org
# User-Agent requis par Nominatim (politique d'usage OSM) — mettre votre contact
GEOCODE_USER_AGENT=mjdata-cluster/0.1 (contact: votre-email@example.com)
